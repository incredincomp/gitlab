{
  "dashboard": {
    "id": null,
    "title": "GitLab Container Monitoring",
    "tags": ["gitlab", "container", "turnkey"],
    "style": "dark",
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "GitLab Services Status",
        "type": "stat",
        "targets": [
          {
            "expr": "gitlab_service_up",
            "legendFormat": "{{service}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "green", "value": 1}
              ]
            },
            "mappings": [
              {"options": {"0": {"text": "Down"}}, "type": "value"},
              {"options": {"1": {"text": "Up"}}, "type": "value"}
            ]
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "System Resource Usage",
        "type": "timeseries",
        "targets": [
          {
            "expr": "gitlab_system_memory_used_bytes / gitlab_system_memory_total_bytes * 100",
            "legendFormat": "Memory %"
          },
          {
            "expr": "gitlab_system_load1",
            "legendFormat": "Load 1m"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "percent"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Database Metrics",
        "type": "timeseries",
        "targets": [
          {
            "expr": "gitlab_database_connections",
            "legendFormat": "Active Connections"
          },
          {
            "expr": "gitlab_database_size_bytes",
            "legendFormat": "Database Size"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"}
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Redis Metrics",
        "type": "timeseries",
        "targets": [
          {
            "expr": "gitlab_redis_memory_bytes",
            "legendFormat": "Redis Memory"
          },
          {
            "expr": "gitlab_redis_clients",
            "legendFormat": "Connected Clients"
          },
          {
            "expr": "gitlab_redis_keys",
            "legendFormat": "Total Keys"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"}
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 5,
        "title": "GitLab Application Stats",
        "type": "stat",
        "targets": [
          {
            "expr": "gitlab_users_total",
            "legendFormat": "Total Users"
          },
          {
            "expr": "gitlab_projects_total", 
            "legendFormat": "Total Projects"
          },
          {
            "expr": "gitlab_issues_total",
            "legendFormat": "Total Issues"
          },
          {
            "expr": "gitlab_merge_requests_total",
            "legendFormat": "Total MRs"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "blue", "value": null}
              ]
            }
          }
        },
        "gridPos": {"h": 4, "w": 24, "x": 0, "y": 16}
      },
      {
        "id": 6,
        "title": "HTTP Response Time",
        "type": "timeseries",
        "targets": [
          {
            "expr": "gitlab_http_response_time_ms",
            "legendFormat": "Response Time (ms)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "ms"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20}
      },
      {
        "id": 7,
        "title": "Disk Usage",
        "type": "timeseries",
        "targets": [
          {
            "expr": "gitlab_disk_used_bytes / gitlab_disk_total_bytes * 100",
            "legendFormat": "{{mount}} usage %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "percent",
            "max": 100
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20}
      },
      {
        "id": 8,
        "title": "Backup Status",
        "type": "stat",
        "targets": [
          {
            "expr": "gitlab_backup_age_seconds / 3600",
            "legendFormat": "Last Backup Age (hours)"
          },
          {
            "expr": "gitlab_backups_total",
            "legendFormat": "Total Backups"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 24},
                {"color": "red", "value": 168}
              ]
            }
          }
        },
        "gridPos": {"h": 4, "w": 12, "x": 0, "y": 28}
      },
      {
        "id": 9,
        "title": "Service Memory Usage",
        "type": "timeseries",
        "targets": [
          {
            "expr": "gitlab_service_memory_mb",
            "legendFormat": "{{service}} Memory (MB)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "decmbytes"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28}
      }
    ],
    "templating": {
      "list": []
    },
    "annotations": {
      "list": []
    },
    "schemaVersion": 30,
    "version": 1,
    "links": []
  }
}