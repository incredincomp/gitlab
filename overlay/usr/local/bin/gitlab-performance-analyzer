# Main profiling function
run_performance_analysis() {
    log "INFO: Starting comprehensive GitLab performance analysis"
    
    # Collect system information
    get_system_info
    
    # Profile all components
    profile_services
    profile_database
    profile_redis
    
    # Monitor performance over time
    monitor_performance
    
    # Analyze GitLab application
    analyze_gitlab_app
    
    # Generate recommendations
    generate_recommendations
    
    # Generate HTML report
    generate_html_report
    
    log "INFO: Performance analysis complete"
    echo "Performance report generated: $REPORT_FILE"
    echo "Raw data available in: $PROFILE_DIR"
}

# Quick performance check
quick_check() {
    log "INFO: Running quick performance check"
    
    echo "=== GitLab Quick Performance Check ==="
    echo "Timestamp: $(date)"
    echo ""
    
    # System resources
    echo "📊 System Resources:"
    echo "  Memory: $(free -h | awk '/^Mem:/ {printf "%s/%s (%.1f%%)", $3, $2, $3/$2*100}')"
    echo "  CPU Cores: $(nproc)"
    echo "  Load Average: $(uptime | awk -F'load average:' '{print $2}' | xargs)"
    echo "  Disk Usage: $(df -h / | awk 'NR==2 {printf "%s/%s (%s)", $3, $2, $5}')"
    echo ""
    
    # Service status
    echo "🔧 GitLab Services:"
    local services=("postgresql" "redis" "nginx" "unicorn" "sidekiq")
    for service in "${services[@]}"; do
        if gitlab-ctl status "$service" 2>/dev/null | grep -q "run:"; then
            local pid
            pid=$(gitlab-ctl status "$service" | awk '/pid/ {print $4}' | tr -d ';' 2>/dev/null)
            local mem_mb
            mem_mb=$(ps -p "$pid" -o rss= 2>/dev/null | awk '{print int($1/1024)}' || echo "0")
            echo "  ✅ $service: Running (PID: $pid, Memory: ${mem_mb}MB)"
        else
            echo "  ❌ $service: Not running"
        fi
    done
    echo ""
    
    # Database quick check
    echo "🗄️ Database:"
    if gitlab-psql -c "SELECT 1;" >/dev/null 2>&1; then
        local db_size connections
        db_size=$(gitlab-psql -t -c "SELECT pg_size_pretty(pg_database_size(current_database()));" 2>/dev/null | xargs || echo "unknown")
        connections=$(gitlab-psql -t -c "SELECT count(*) FROM pg_stat_activity;" 2>/dev/null | xargs || echo "0")
        echo "  ✅ PostgreSQL: Connected (Size: $db_size, Connections: $connections)"
    else
        echo "  ❌ PostgreSQL: Connection failed"
    fi
    
    # Redis quick check
    if gitlab-redis-cli ping 2>/dev/null | grep -q "PONG"; then
        local redis_memory
        redis_memory=$(gitlab-redis-cli info memory 2>/dev/null | grep "used_memory_human:" | cut -d: -f2 | tr -d '\r' || echo "unknown")
        echo "  ✅ Redis: Connected (Memory: $redis_memory)"
    else
        echo "  ❌ Redis: Connection failed"
    fi
    echo ""
    
    # Application quick check
    echo "🌐 Application:"
    local external_url
    external_url=$(grep "^external_url" /etc/gitlab/gitlab.rb | cut -d"'" -f2 2>/dev/null || echo "http://localhost")
    local check_url
    check_url=$(echo "$external_url" | sed 's/https\?:\/\/[^\/]*/http:\/\/localhost/')
    
    local start_time end_time response_time http_code
    start_time=$(date +%s%N)
    http_code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 10 "$check_url/users/sign_in" 2>/dev/null || echo "000")
    end_time=$(date +%s%N)
    response_time=$(( (end_time - start_time) / 1000000 ))
    
    if [[ "$http_code" == "200" ]]; then
        echo "  ✅ Web Interface: Accessible (Response: ${response_time}ms)"
    else
        echo "  ❌ Web Interface: Not accessible (HTTP $http_code)"
    fi
}

# Main function
main() {
    case "${1:-analysis}" in
        analysis|full)
            run_performance_analysis
            ;;
        quick)
            quick_check
            ;;
        monitor)
            monitor_performance
            echo "Performance monitoring data saved to: $PROFILE_DIR/performance_timeline.csv"
            ;;
        recommendations)
            get_system_info
            profile_services
            generate_recommendations
            cat "$PROFILE_DIR/recommendations.txt"
            ;;
        *)
            echo "Usage: $0 [analysis|quick|monitor|recommendations]"
            echo "  analysis        - Full performance analysis with HTML report (default)"
            echo "  quick          - Quick performance status check"
            echo "  monitor        - Monitor performance metrics over time"
            echo "  recommendations - Generate performance recommendations"
            exit 1
            ;;
    esac
}

main "$@"