</html>
EOF

    # Replace timestamp
    sed -i "s/TIMESTAMP/$(date '+%Y-%m-%d %H:%M:%S %Z')/g" "$REPORT_FILE"
    
    log "INFO: Security report generated: $REPORT_FILE"
}

# Run comprehensive security assessment
run_security_assessment() {
    log "INFO: Starting comprehensive GitLab security assessment"
    
    # Check for security updates
    check_security_updates
    
    # Scan network exposure
    scan_network_exposure
    
    # Check GitLab security configuration
    check_gitlab_security_config
    
    # Check file permissions
    check_file_permissions
    
    # Scan for malware and suspicious activity
    scan_malware
    
    # Check database security
    check_database_security
    
    # Generate WAF rules
    create_waf_rules
    
    # Generate security recommendations
    generate_security_recommendations
    
    # Generate HTML report
    generate_security_report
    
    log "INFO: Security assessment complete"
    echo ""
    echo "🔒 GitLab Security Assessment Complete!"
    echo "📊 Report available at: $REPORT_FILE"
    echo "📋 Recommendations: $SECURITY_DIR/security_recommendations.txt"
    echo "🛡️ WAF rules created: /etc/gitlab/waf-rules.conf"
    echo ""
    echo "Key Findings Summary:"
    
    # Quick summary
    local updates_available
    updates_available=$(jq -r '.security_updates_available' "$SECURITY_DIR/update_status.json" 2>/dev/null || echo "unknown")
    
    if [[ "$updates_available" == "true" ]]; then
        echo "  🚨 Security updates available - apply immediately"
    else
        echo "  ✅ System appears up to date"
    fi
    
    local https_enabled
    https_enabled=$(jq -r '.https_redirect_enabled' "$SECURITY_DIR/gitlab_security_config.json" 2>/dev/null || echo "unknown")
    
    if [[ "$https_enabled" == "true" ]]; then
        echo "  ✅ HTTPS is properly configured"
    else
        echo "  ⚠️ HTTPS configuration needs review"
    fi
    
    echo "  📈 Overall security posture: Good"
    echo ""
}

# Quick security check
quick_security_check() {
    log "INFO: Running quick security check"
    
    echo "🔒 GitLab Security Quick Check"
    echo "=============================="
    echo ""
    
    # Check HTTPS configuration
    local external_url
    external_url=$(grep "^external_url" /etc/gitlab/gitlab.rb | cut -d"'" -f2 2>/dev/null || echo "")
    
    if [[ "$external_url" =~ ^https:// ]]; then
        echo "✅ HTTPS: Enabled"
    else
        echo "⚠️ HTTPS: Not configured or using HTTP"
    fi
    
    # Check for security updates
    if apt list --upgradable 2>/dev/null | grep -qi security; then
        echo "🚨 Security Updates: Available (please apply)"
    else
        echo "✅ Security Updates: Up to date"
    fi
    
    # Check file permissions
    local config_perms
    config_perms=$(stat -c %a /etc/gitlab/gitlab.rb 2>/dev/null || echo "unknown")
    
    if [[ "$config_perms" == "600" || "$config_perms" == "640" ]]; then
        echo "✅ Config Permissions: Secure ($config_perms)"
    else
        echo "⚠️ Config Permissions: Check needed ($config_perms)"
    fi
    
    # Check services
    local critical_services=("nginx" "unicorn" "postgresql")
    local services_ok=true
    
    for service in "${critical_services[@]}"; do
        if ! gitlab-ctl status "$service" >/dev/null 2>&1; then
            services_ok=false
        fi
    done
    
    if $services_ok; then
        echo "✅ Critical Services: Running"
    else
        echo "⚠️ Critical Services: Check needed"
    fi
    
    echo ""
    echo "For detailed analysis, run: gitlab-security-scanner full"
}

# Main function
main() {
    case "${1:-assessment}" in
        assessment|full)
            run_security_assessment
            ;;
        quick)
            quick_security_check
            ;;
        updates)
            check_security_updates
            cat "$SECURITY_DIR/update_status.json" 2>/dev/null || echo "Update check not available"
            ;;
        waf)
            create_waf_rules
            echo "WAF rules created in /etc/gitlab/"
            ;;
        recommendations)
            generate_security_recommendations
            cat "$SECURITY_DIR/security_recommendations.txt"
            ;;
        *)
            echo "Usage: $0 [assessment|quick|updates|waf|recommendations]"
            echo "  assessment      - Full security assessment with HTML report (default)"
            echo "  quick          - Quick security status check"
            echo "  updates        - Check for security updates"
            echo "  waf            - Generate WAF rules"
            echo "  recommendations - Generate security recommendations"
            exit 1
            ;;
    esac
}

main "$@"