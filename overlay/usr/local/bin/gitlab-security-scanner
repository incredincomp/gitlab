#!/bin/bash
# GitLab Advanced Security Scanner and Vulnerability Assessment
# Comprehensive security analysis and hardening recommendations

set -euo pipefail

# Configuration
SECURITY_DIR="/var/log/gitlab-security"
REPORT_FILE="$SECURITY_DIR/security-report-$(date +%Y%m%d-%H%M%S).html"
LOG_FILE="/var/log/gitlab-security.log"

# Ensure security directory exists
mkdir -p "$SECURITY_DIR"

# Logging function
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG_FILE"
}

# Check for security updates
check_security_updates() {
    log "INFO: Checking for security updates"
    
    local updates_available=0
    local security_updates=""
    
    # Update package lists
    apt-get update >/dev/null 2>&1 || true
    
    # Check for upgradable packages
    if command -v apt-list-upgrades >/dev/null 2>&1; then
        security_updates=$(apt list --upgradable 2>/dev/null | grep -i security || true)
    else
        security_updates=$(apt list --upgradable 2>/dev/null | grep -E "(security|CVE)" || true)
    fi
    
    if [[ -n "$security_updates" ]]; then
        updates_available=1
        echo "$security_updates" > "$SECURITY_DIR/security_updates.txt"
    fi
    
    # Check GitLab version
    local gitlab_version
    gitlab_version=$(gitlab-rake gitlab:env:info 2>/dev/null | grep "GitLab information" -A 20 | grep "Version:" | awk '{print $2}' || echo "unknown")
    
    cat > "$SECURITY_DIR/update_status.json" << EOF
{
  "security_updates_available": $updates_available,
  "gitlab_version": "$gitlab_version",
  "last_check": "$(date -I)",
  "system_packages_checked": true
}
EOF
    
    if [[ $updates_available -eq 1 ]]; then
        log "WARNING: Security updates are available"
    else
        log "INFO: No security updates found"
    fi
}

# Scan for open ports and services
scan_network_exposure() {
    log "INFO: Scanning network exposure"
    
    # Check listening ports
    local listening_ports
    listening_ports=$(ss -tlnp | grep LISTEN | awk '{print $4}' | sort -u)
    
    echo "Port,Service,Process" > "$SECURITY_DIR/open_ports.csv"
    
    while IFS= read -r port_line; do
        local port
        port=$(echo "$port_line" | grep -o '[0-9]\+$')
        
        if [[ -n "$port" ]]; then
            local service_info
            service_info=$(ss -tlnp | grep ":$port " | head -1)
            
            local process
            process=$(echo "$service_info" | grep -o 'users:(([^)]*))' | sed 's/users:((\([^)]*\)))/\1/' | cut -d'"' -f2 || echo "unknown")
            
            # Identify service type
            local service_name="unknown"
            case $port in
                22) service_name="SSH" ;;
                80) service_name="HTTP" ;;
                443) service_name="HTTPS" ;;
                5432) service_name="PostgreSQL" ;;
                6379) service_name="Redis" ;;
                8080) service_name="GitLab-Unicorn" ;;
                9168) service_name="GitLab-Metrics" ;;
                *) service_name="unknown" ;;
            esac
            
            echo "$port,$service_name,$process" >> "$SECURITY_DIR/open_ports.csv"
        fi
    done <<< "$listening_ports"
    
    # Check for unexpected open ports
    local unexpected_ports=()
    while IFS=',' read -r port service process; do
        if [[ "$port" != "Port" ]]; then  # Skip header
            case $port in
                22|80|443|5432|6379|8080|9168) ;;  # Expected GitLab ports
                *) unexpected_ports+=("$port ($service)") ;;
            esac
        fi
    done < "$SECURITY_DIR/open_ports.csv"
    
    if [[ ${#unexpected_ports[@]} -gt 0 ]]; then
        log "WARNING: Unexpected open ports found: ${unexpected_ports[*]}"
    fi
}

# Check GitLab configuration security
check_gitlab_security_config() {
    log "INFO: Checking GitLab 18.4 security configuration"
    
    local security_issues=()
    local config_file="/etc/gitlab/gitlab.rb"
    
    # Check SSL/TLS configuration
    if ! grep -q "nginx\['redirect_http_to_https'\].*true" "$config_file" 2>/dev/null; then
        security_issues+=("HTTP to HTTPS redirect not enabled")
    fi
    
    if ! grep -q "nginx\['ssl_protocols'\]" "$config_file" 2>/dev/null; then
        security_issues+=("SSL protocols not explicitly configured")
    fi
    
    if ! grep -q "nginx\['hsts_max_age'\]" "$config_file" 2>/dev/null; then
        security_issues+=("HSTS not configured")
    fi
    
    # Check GitLab 18.4 specific security features
    if ! grep -q "job_artifact_access_controls.*true" "$config_file" 2>/dev/null; then
        security_issues+=("GitLab 18.4 enhanced artifact access controls not enabled")
    fi
    
    if ! grep -q "advanced_sast_performance_improvements.*true" "$config_file" 2>/dev/null; then
        security_issues+=("GitLab 18.4 SAST performance improvements not enabled")
    fi
    
    if ! grep -q "enhanced_secret_detection.*true" "$config_file" 2>/dev/null; then
        security_issues+=("GitLab 18.4 enhanced secret detection not enabled")
    fi
    
    # Check external URL
    local external_url
    external_url=$(grep "^external_url" "$config_file" | cut -d"'" -f2 2>/dev/null || echo "")
    if [[ "$external_url" =~ ^http:// ]]; then
        security_issues+=("External URL uses HTTP instead of HTTPS")
    fi
    
    # Check for default passwords or insecure settings
    if grep -q "password.*123\|password.*admin\|password.*password" "$config_file" 2>/dev/null; then
        security_issues+=("Potential weak passwords found in configuration")
    fi
    
    # Check GitLab application settings
    local signup_enabled
    signup_enabled=$(timeout 30 gitlab-rails runner "puts ApplicationSetting.current.signup_enabled" 2>/dev/null || echo "unknown")
    if [[ "$signup_enabled" == "true" ]]; then
        security_issues+=("Public user registration is enabled")
    fi
    
    # Check for admin users
    local admin_count
    admin_count=$(timeout 30 gitlab-rails runner "puts User.admins.count" 2>/dev/null || echo "0")
    if [[ "$admin_count" -gt 5 ]]; then
        security_issues+=("Unusually high number of admin users: $admin_count")
    fi
    
    # Check GitLab 18.4 vulnerability management features
    local vuln_auto_resolve
    vuln_auto_resolve=$(grep -c "vulnerability_auto_resolve_tracking.*true" "$config_file" 2>/dev/null || echo "0")
    if [[ "$vuln_auto_resolve" -eq 0 ]]; then
        security_issues+=("GitLab 18.4 vulnerability auto-resolve tracking not enabled")
    fi
    
    # Save security configuration status
    cat > "$SECURITY_DIR/gitlab_security_config.json" << EOF
{
  "gitlab_version": "18.4",
  "external_url": "$external_url",
  "https_redirect_enabled": $(grep -q "nginx\['redirect_http_to_https'\].*true" "$config_file" && echo "true" || echo "false"),
  "hsts_enabled": $(grep -q "nginx\['hsts_max_age'\]" "$config_file" && echo "true" || echo "false"),
  "signup_enabled": "$signup_enabled",
  "admin_user_count": $admin_count,
  "gitlab_18_4_features": {
    "enhanced_artifact_controls": $(grep -q "job_artifact_access_controls.*true" "$config_file" && echo "true" || echo "false"),
    "sast_performance_improvements": $(grep -q "advanced_sast_performance_improvements.*true" "$config_file" && echo "true" || echo "false"),
    "enhanced_secret_detection": $(grep -q "enhanced_secret_detection.*true" "$config_file" && echo "true" || echo "false"),
    "vulnerability_auto_resolve": $(grep -q "vulnerability_auto_resolve_tracking.*true" "$config_file" && echo "true" || echo "false")
  },
  "security_issues": [
$(printf '    "%s"' "${security_issues[0]:-}")
$(for issue in "${security_issues[@]:1}"; do printf ',\n    "%s"' "$issue"; done)
  ]
}
EOF
    
    if [[ ${#security_issues[@]} -gt 0 ]]; then
        log "WARNING: ${#security_issues[@]} security issues found in GitLab configuration"
        printf '  - %s\n' "${security_issues[@]}"
    else
        log "INFO: GitLab 18.4 security configuration looks good"
    fi
}

# Check file permissions and ownership
check_file_permissions() {
    log "INFO: Checking file permissions and ownership"
    
    local permission_issues=()
    
    # Check GitLab configuration file permissions
    local gitlab_config="/etc/gitlab/gitlab.rb"
    if [[ -f "$gitlab_config" ]]; then
        local perms
        perms=$(stat -c %a "$gitlab_config")
        if [[ "$perms" != "600" && "$perms" != "640" ]]; then
            permission_issues+=("GitLab config file has insecure permissions: $perms")
        fi
    fi
    
    # Check SSL certificate permissions if they exist
    local ssl_cert_dir="/etc/gitlab/ssl"
    if [[ -d "$ssl_cert_dir" ]]; then
        while IFS= read -r -d '' cert_file; do
            local cert_perms
            cert_perms=$(stat -c %a "$cert_file")
            if [[ "$cert_perms" != "600" && "$cert_perms" != "644" ]]; then
                permission_issues+=("SSL certificate has insecure permissions: $(basename "$cert_file") ($cert_perms)")
            fi
        done < <(find "$ssl_cert_dir" -name "*.crt" -o -name "*.key" -print0 2>/dev/null)
    fi
    
    # Check for world-writable files in GitLab directories
    local writable_files
    writable_files=$(find /opt/gitlab /var/opt/gitlab -type f -perm -002 2>/dev/null | head -10)
    if [[ -n "$writable_files" ]]; then
        permission_issues+=("World-writable files found in GitLab directories")
        echo "$writable_files" > "$SECURITY_DIR/writable_files.txt"
    fi
    
    # Check for SUID/SGID files
    local suid_files
    suid_files=$(find /opt/gitlab -type f \( -perm -4000 -o -perm -2000 \) 2>/dev/null)
    if [[ -n "$suid_files" ]]; then
        echo "$suid_files" > "$SECURITY_DIR/suid_files.txt"
    fi
    
    # Save permission check results
    cat > "$SECURITY_DIR/file_permissions.json" << EOF
{
  "gitlab_config_perms": "$(stat -c %a "$gitlab_config" 2>/dev/null || echo "not_found")",
  "ssl_cert_dir_exists": $([ -d "$ssl_cert_dir" ] && echo "true" || echo "false"),
  "world_writable_files_found": $([ -n "$writable_files" ] && echo "true" || echo "false"),
  "suid_files_found": $([ -n "$suid_files" ] && echo "true" || echo "false"),
  "permission_issues": [
$(printf '    "%s"' "${permission_issues[0]:-}")
$(for issue in "${permission_issues[@]:1}"; do printf ',\n    "%s"' "$issue"; done)
  ]
}
EOF
    
    if [[ ${#permission_issues[@]} -gt 0 ]]; then
        log "WARNING: ${#permission_issues[@]} file permission issues found"
    else
        log "INFO: File permissions look secure"
    fi
}

# Check for malware and suspicious files
scan_malware() {
    log "INFO: Scanning for malware and suspicious files"
    
    local suspicious_files=()
    
    # Look for common malware indicators
    local malware_patterns=(
        "*.php.suspected"
        "*.jsp.suspected" 
        "*shell*"
        "*backdoor*"
        "*malware*"
        "*.tmp.php"
        "*.tmp.jsp"
    )
    
    for pattern in "${malware_patterns[@]}"; do
        local found_files
        found_files=$(find /opt/gitlab /var/opt/gitlab -name "$pattern" -type f 2>/dev/null || true)
        if [[ -n "$found_files" ]]; then
            suspicious_files+=("$found_files")
        fi
    done
    
    # Look for suspicious processes
    local suspicious_processes
    suspicious_processes=$(ps aux | grep -E "(nc|netcat|ncat|socat|wget|curl).*sh\b" | grep -v grep || true)
    
    # Check for unusual network connections
    local suspicious_connections
    suspicious_connections=$(ss -antp | grep -E "(:4444|:5555|:6666|:7777|:8888|:9999)" | grep -v gitlab || true)
    
    cat > "$SECURITY_DIR/malware_scan.json" << EOF
{
  "suspicious_files": [
$(if [[ ${#suspicious_files[@]} -gt 0 ]]; then
    printf '    "%s"' "${suspicious_files[0]}"
    for file in "${suspicious_files[@]:1}"; do
        printf ',\n    "%s"' "$file"
    done
fi)
  ],
  "suspicious_processes": $([ -n "$suspicious_processes" ] && echo "true" || echo "false"),
  "suspicious_connections": $([ -n "$suspicious_connections" ] && echo "true" || echo "false"),
  "scan_timestamp": "$(date -I)"
}
EOF
    
    if [[ ${#suspicious_files[@]} -gt 0 ]] || [[ -n "$suspicious_processes" ]] || [[ -n "$suspicious_connections" ]]; then
        log "WARNING: Potentially suspicious activity detected"
        [[ -n "$suspicious_processes" ]] && echo "$suspicious_processes" > "$SECURITY_DIR/suspicious_processes.txt"
        [[ -n "$suspicious_connections" ]] && echo "$suspicious_connections" > "$SECURITY_DIR/suspicious_connections.txt"
    else
        log "INFO: No obvious malware or suspicious activity detected"
    fi
}

# Check database security
check_database_security() {
    log "INFO: Checking database security configuration"
    
    local db_issues=()
    
    if gitlab-psql -c "SELECT 1;" >/dev/null 2>&1; then
        # Check for default/weak passwords
        local weak_users
        weak_users=$(gitlab-psql -t -c "SELECT usename FROM pg_user WHERE usename IN ('postgres', 'admin', 'root', 'gitlab');" 2>/dev/null | grep -v "^$" | wc -l || echo "0")
        
        # Check for users with superuser privileges
        local superusers
        superusers=$(gitlab-psql -t -c "SELECT count(*) FROM pg_user WHERE usesuper = true;" 2>/dev/null | xargs || echo "0")
        
        # Check database access configuration
        local hba_config="/var/opt/gitlab/postgresql/data/pg_hba.conf"
        if [[ -f "$hba_config" ]]; then
            local trust_connections
            trust_connections=$(grep -c "trust" "$hba_config" 2>/dev/null || echo "0")
            if [[ "$trust_connections" -gt 0 ]]; then
                db_issues+=("Database has trust authentication enabled")
            fi
        fi
        
        # Check for unencrypted connections
        if ! gitlab-psql -t -c "SHOW ssl;" 2>/dev/null | grep -q "on"; then
            db_issues+=("SSL not enabled for database connections")
        fi
        
        cat > "$SECURITY_DIR/database_security.json" << EOF
{
  "database_accessible": true,
  "weak_username_count": $weak_users,
  "superuser_count": $superusers,
  "ssl_enabled": $(gitlab-psql -t -c "SHOW ssl;" 2>/dev/null | grep -q "on" && echo "true" || echo "false"),
  "trust_connections": $trust_connections,
  "security_issues": [
$(printf '    "%s"' "${db_issues[0]:-}")
$(for issue in "${db_issues[@]:1}"; do printf ',\n    "%s"' "$issue"; done)
  ]
}
EOF
    else
        echo '{"database_accessible": false}' > "$SECURITY_DIR/database_security.json"
        db_issues+=("Cannot connect to database for security assessment")
    fi
    
    if [[ ${#db_issues[@]} -gt 0 ]]; then
        log "WARNING: ${#db_issues[@]} database security issues found"
    else
        log "INFO: Database security configuration is acceptable"
    fi
}

# Generate security recommendations
generate_security_recommendations() {
    log "INFO: Generating security recommendations"
    
    local recommendations=()
    
    # System-level recommendations
    recommendations+=("🔒 SYSTEM SECURITY:")
    recommendations+=("  ✅ Keep system packages updated regularly")
    recommendations+=("  ✅ Monitor security advisories for GitLab")
    recommendations+=("  ✅ Implement proper firewall rules")
    recommendations+=("  ✅ Use fail2ban for brute force protection")
    recommendations+=("")
    
    # GitLab-specific recommendations
    recommendations+=("🦊 GITLAB SECURITY:")
    recommendations+=("  ✅ Enable HTTPS with proper SSL/TLS configuration")
    recommendations+=("  ✅ Configure HSTS headers")
    recommendations+=("  ✅ Disable public user registration unless needed")
    recommendations+=("  ✅ Regularly audit admin users")
    recommendations+=("  ✅ Enable two-factor authentication for all users")
    recommendations+=("  ✅ Configure IP whitelisting for admin areas")
    recommendations+=("")
    
    # Database security recommendations  
    recommendations+=("🗄️ DATABASE SECURITY:")
    recommendations+=("  ✅ Use strong database passwords")
    recommendations+=("  ✅ Enable SSL for database connections")
    recommendations+=("  ✅ Restrict database network access")
    recommendations+=("  ✅ Regular database security audits")
    recommendations+=("")
    
    # File system recommendations
    recommendations+=("📁 FILE SYSTEM SECURITY:")
    recommendations+=("  ✅ Set proper file permissions (600 for configs)")
    recommendations+=("  ✅ Regular file integrity monitoring")
    recommendations+=("  ✅ Secure SSL certificate storage")
    recommendations+=("  ✅ Monitor for unauthorized file changes")
    recommendations+=("")
    
    # Monitoring recommendations
    recommendations+=("📊 SECURITY MONITORING:")
    recommendations+=("  ✅ Enable comprehensive audit logging")
    recommendations+=("  ✅ Set up intrusion detection")
    recommendations+=("  ✅ Monitor for suspicious network activity")
    recommendations+=("  ✅ Regular security scans")
    recommendations+=("  ✅ Backup integrity verification")
    recommendations+=("")
    
    # Process specific issues found
    if [[ -f "$SECURITY_DIR/update_status.json" ]]; then
        local updates_available
        updates_available=$(jq -r '.security_updates_available' "$SECURITY_DIR/update_status.json" 2>/dev/null || echo "false")
        if [[ "$updates_available" == "true" ]]; then
            recommendations+=("🚨 URGENT: Security updates are available - apply immediately")
        fi
    fi
    
    if [[ -f "$SECURITY_DIR/gitlab_security_config.json" ]]; then
        local https_redirect
        https_redirect=$(jq -r '.https_redirect_enabled' "$SECURITY_DIR/gitlab_security_config.json" 2>/dev/null || echo "false")
        if [[ "$https_redirect" == "false" ]]; then
            recommendations+=("🔧 CONFIGURE: Enable HTTPS redirect in GitLab configuration")
        fi
        
        local signup_enabled
        signup_enabled=$(jq -r '.signup_enabled' "$SECURITY_DIR/gitlab_security_config.json" 2>/dev/null || echo "unknown")
        if [[ "$signup_enabled" == "true" ]]; then
            recommendations+=("⚠️ REVIEW: Public user registration is enabled - consider disabling")
        fi
    fi
    
    # Save recommendations
    printf '%s\n' "${recommendations[@]}" > "$SECURITY_DIR/security_recommendations.txt"
}

# Create simple WAF rules for nginx
create_waf_rules() {
    log "INFO: Creating basic WAF rules"
    
    local waf_config="/etc/gitlab/waf-rules.conf"
    
    cat > "$waf_config" << 'EOF'
# Basic WAF rules for GitLab
# Include this in your nginx configuration

# Block common attack patterns
location ~* \.(php|asp|aspx|jsp)$ {
    return 403;
}

# Block SQL injection attempts
if ($args ~* "(union|select|insert|drop|update|delete|exec|script)" ) {
    return 403;
}

# Block XSS attempts  
if ($args ~* "(<|%3C).*script.*(>|%3E)" ) {
    return 403;
}

# Block directory traversal attempts
if ($args ~* "\.\./") {
    return 403;
}

# Rate limiting for login endpoints
location = /users/sign_in {
    limit_req zone=login burst=5 nodelay;
    proxy_pass http://gitlab-workhorse;
}

# Rate limiting for API endpoints
location /api/ {
    limit_req zone=api burst=10 nodelay;
    proxy_pass http://gitlab-workhorse;
}

# Security headers
add_header X-Frame-Options SAMEORIGIN;
add_header X-Content-Type-Options nosniff;
add_header X-XSS-Protection "1; mode=block";
add_header Referrer-Policy strict-origin-when-cross-origin;
EOF

    # Create rate limiting configuration
    cat > "/etc/gitlab/rate-limiting.conf" << 'EOF'
# Rate limiting configuration for GitLab
# Add to nginx http block

http {
    # Define rate limiting zones
    limit_req_zone $binary_remote_addr zone=login:10m rate=5r/m;
    limit_req_zone $binary_remote_addr zone=api:10m rate=30r/m;
    limit_req_zone $binary_remote_addr zone=general:10m rate=60r/m;
    
    # Connection limiting
    limit_conn_zone $binary_remote_addr zone=conn_limit_per_ip:10m;
    limit_conn conn_limit_per_ip 20;
}
EOF

    log "INFO: WAF rules created at $waf_config"
    log "INFO: To enable, include these files in your GitLab nginx configuration"
}

