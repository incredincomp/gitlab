#!/bin/bash -e
# regenerate gitlab secrets

. /etc/default/inithooks

# already removed during initial build, but just in case they're being re-run.
mv /etc/gitlab/gitlab-secrets.json /etc/gitlab/gitlab-secrets.json.bak || true

if ! systemctl is-active --quiet gitlab-runsvdir.service; then
    systemctl start gitlab-runsvdir.service
    # Give the service time to start before proceeding
    sleep 10
    
    # Wait for basic service readiness
    max_attempts=30
    attempt=0
    while [ $attempt -lt $max_attempts ]; do
        if gitlab-ctl status 2>/dev/null | grep -q "run:"; then
            break
        fi
        echo "Waiting for GitLab services to start (attempt $((attempt + 1))/$max_attempts)..."
        sleep 5
        attempt=$((attempt + 1))
    done
fi
